rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /invites/{token} {
      allow get: if true;
      allow list: if isMember();
      allow create: if isMember() && token.size() >= 20;
      allow delete: if isMember();
    }

    match /members/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.inviteToken is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken));
      allow read, delete: if isMember();
    }
  }
}
